{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.app.json",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/format.ts",
    "src/ads.ts",
    "src/analytics.ts",
    "src/labels.ts",
    "src/api/client.ts",
    "src/store/authStore.ts",
    "src/store/maintenanceStore.ts",
    "src/hooks/useExamCountdown.ts",
    "src/hooks/useApiQuery.ts",
    "src/hooks/useExam.ts",
    "src/hooks/useExamVariantUpdate.ts",
    "src/hooks/useProgressSummary.ts",
    "src/hooks/useScrollToHash.ts",
    "src/contact.ts",
    "src/scroll.ts",
    "src/faq.ts",
    "src/share.ts",
    "src/legal.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "cleanTempDir": true
}
