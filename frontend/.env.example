# Copy to .env for local dev (gitignored). In production, render.yaml sets
# this to https://api.sks-lotse.de (ADR-0015).
VITE_API_BASE_URL=http://localhost:8000

# Umami Cloud website id (see ADR-0016). Left unset in local dev/CI on
# purpose — src/analytics.ts only loads the tracking script when this is
# set, so dev/test traffic never gets counted. Set in production via
# Render's dashboard (sync: false in render.yaml, not committed).
VITE_UMAMI_WEBSITE_ID=

# Google AdSense publisher id, ca-pub-… (see ADR-0027). Left unset in local
# dev/CI — vite.config.ts only injects the ad script into the built HTML when this is set; unset,
# the "Cookies" footer button is absent too. Set in production via Render's dashboard (sync: false
# in render.yaml).
VITE_ADSENSE_CLIENT_ID=

# Ad units in the app (ADR-0027 addendum 2026-10-05): "on" lets the app load Google's script at runtime
# where ads are shown. Unset/off, the app runs no ad script (there is no ad unit yet); the public pages
# keep their static tag for AdSense's site review. Switch it on together with the first ad unit.
VITE_AD_UNITS=

# The Kartenaufgaben for guests (ADR-0056): off | admins | on, unset = off, anything else fails the
# build. Only "on" opens /charts without a login and prerenders its pages; keep it in step with the
# backend's CHART_EXERCISES (render.yaml sets both alike).
VITE_CHART_EXERCISES=
