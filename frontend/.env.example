# Copy to .env for local dev (gitignored). In production, render.yaml sets
# this to https://api.sks-lotse.de (ADR-0015).
VITE_API_BASE_URL=http://localhost:8000

# Umami Cloud website id (see ADR-0016). Left unset in local dev/CI on
# purpose — src/analytics.ts only loads the tracking script when this is
# set, so dev/test traffic never gets counted. Set in production via
# Render's dashboard (sync: false in render.yaml, not committed).
VITE_UMAMI_WEBSITE_ID=

# Google AdSense publisher id, ca-pub-… (see ADR-0027). Left unset in local
# dev/CI — src/ads.ts only loads the ad script when this is set. Set in
# production via Render's dashboard (sync: false in render.yaml).
VITE_ADSENSE_CLIENT_ID=
