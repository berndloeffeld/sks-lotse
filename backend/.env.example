DATABASE_URL=postgresql://sks_lotse:sks_lotse@localhost:5432/sks_lotse
# RENDER=  # set to true automatically by Render — leave unset locally (enables proxy client-IP headers)
# ENVIRONMENT=  # optional: development (default), test, or production — anything else fails at startup
# Required — no insecure fallback, at least 32 characters in every environment
# (signs JWTs and hashes OTP codes); generate one with `openssl rand -hex 32`.
JWT_SECRET=
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=  # optional, defaults to 10080 (7 days)
OPENAI_API_KEY=
ADSENSE_CLIENT_ID=
# Required to actually send OTP emails locally — leave empty to see the
# "Failed to send OTP email" log line instead (the API still returns 202).
RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=  # optional, defaults to noreply@sks-lotse.de
# ALLOWED_EMAILS=  # optional, comma-separated login allowlist — leave unset locally
# OTP_LENGTH=  # optional, defaults to 6
# OTP_TTL_MINUTES=  # optional, defaults to 10
# OTP_MAX_ATTEMPTS=  # optional, defaults to 5
# OTP_RESEND_COOLDOWN_SECONDS=  # optional, defaults to 60
# OTP_REQUEST_WINDOW_MINUTES=  # optional, defaults to 60
# OTP_MAX_REQUESTS_PER_WINDOW=  # optional, defaults to 5
# OTP_CODE_RETENTION_HOURS=  # optional, defaults to 24
# OTP_CLEANUP_MIN_INTERVAL_SECONDS=  # optional, defaults to 300 (5 minutes)
# RATE_LIMIT_OTP_MAX_REQUESTS=  # optional, defaults to 20
# RATE_LIMIT_OTP_WINDOW_SECONDS=  # optional, defaults to 3600 (1 hour)
# RATE_LIMIT_DEFAULT_MAX_REQUESTS=  # optional, defaults to 300
# RATE_LIMIT_DEFAULT_WINDOW_SECONDS=  # optional, defaults to 300 (5 minutes)
# CATALOG_CACHE_TTL_SECONDS=  # optional, defaults to 3600 (1 hour)
