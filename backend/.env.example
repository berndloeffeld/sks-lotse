DATABASE_URL=postgresql://sks_lotse:sks_lotse@localhost:5432/sks_lotse
# RENDER=  # set to true automatically by Render — leave unset locally (enables proxy client-IP headers)
# MAINTENANCE_MODE=  # optional, defaults to false — manual kill switch, blocks all of /api/v1 except /health (docs/RUNBOOK.md)
# ENVIRONMENT=  # optional: development (default), test, or production — anything else fails at startup.
#   Dev tooling (Swagger/ReDoc/OpenAPI, the OTP _dev-peek) only for development/test, and never when
#   RENDER is set: a Render service always counts as production, even with ENVIRONMENT forgotten.
# Required — no insecure fallback, at least 32 characters in every environment
# (signs JWTs and hashes OTP codes); generate one with `openssl rand -hex 32`. Rotating it
# invalidates all sessions and pending codes (docs/RUNBOOK.md → Rotating secrets).
JWT_SECRET=
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=  # optional, defaults to 10080 (7 days)
# Local dev tooling only: backend/scripts/manage_topics.py (question topic
# classification) — not read by the running app.
ANTHROPIC_API_KEY=
# The app's own key for the AI answer check (Claude Haiku for catalog questions, Sonnet
# for Kartenaufgaben — one key serves both) — use a separate key (own Console workspace)
# from the one above. Empty = the endpoint answers 503.
ANTHROPIC_GRADING_API_KEY=
# ANTHROPIC_GRADING_MODEL=  # optional, defaults to claude-haiku-4-5
# GRADING_MAX_ANSWER_CHARS=  # optional, defaults to 1000
# ANTHROPIC_GRADING_TIMEOUT_SECONDS=  # optional, defaults to 15
# ANTHROPIC_CHART_GRADING_MODEL=  # optional, the Kartenaufgaben check (ADR-0058), defaults to claude-sonnet-5-5
# ANTHROPIC_CHART_GRADING_TIMEOUT_SECONDS=  # optional, defaults to 45
# GRADING_MAX_PER_WINDOW=  # optional, defaults to 30 per window
# GRADING_WINDOW_SECONDS=  # optional, defaults to 3600
# GRADING_MAX_PER_QUESTION_PER_DAY=  # optional, defaults to 2
# GRADING_MAX_CONCURRENT_CALLS=  # optional, defaults to 5 (LLM calls in flight across all accounts)
# GRADING_FEEDBACK_MAX_CHARS=  # optional, defaults to 500 (sanitizer backstop, ADR-0040)
# GRADING_SANITIZER_LOG_THRESHOLD=  # optional, defaults to 3 (extended per-account logging, ADR-0040)
# The Kartenaufgaben (ADR-0052): off (default) | admins (ADMIN_EMAILS only) | on.
# CHART_EXERCISES=off
# Token-package checkout (ADR-0048, docs/stripe/README.md). STRIPE_CHECKOUT is the feature flag:
# off (default) | admins (ADMIN_EMAILS only) | on. Use test-mode keys locally (sk_test_…); the
# webhook secret comes from `stripe listen` (whsec_…). Empty key = checkout refused, webhook 503.
# STRIPE_CHECKOUT=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe product ids (prod_…) of the four token packages — different in test and live mode.
STRIPE_PRODUCT_TOKENS_S=
STRIPE_PRODUCT_TOKENS_M=
STRIPE_PRODUCT_TOKENS_L=
STRIPE_PRODUCT_TOKENS_XL=
# Required to actually send OTP emails locally — leave empty to see the
# "Failed to send OTP email" log line instead (the API still returns 202). The sending domain must be
# verified at Resend via IONOS DNS records before mail goes out.
RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=  # optional, defaults to "SKS Lotse <noreply@sks-lotse.de>"
# ALLOWED_EMAILS=  # optional, comma-separated login allowlist (private beta) — unset = open to everyone; non-listed
#   addresses get the same generic 202 with no code and no email. Leave unset locally.
#   Both allowlists are canonicalized like every address (app/core/email_address.py), so any spelling works.
# ADMIN_EMAILS=  # optional, comma-separated GDPR-admin-tools allowlist — empty/unset means NO admins (fail closed, opposite of ALLOWED_EMAILS above)
# OTP_LENGTH=  # optional, defaults to 6
# OTP_TTL_MINUTES=  # optional, defaults to 10
# OTP_MAX_ATTEMPTS=  # optional, defaults to 5
# OTP_RESEND_COOLDOWN_SECONDS=  # optional, defaults to 60
# OTP_REQUEST_WINDOW_MINUTES=  # optional, defaults to 60
# OTP_MAX_REQUESTS_PER_WINDOW=  # optional, defaults to 5
# OTP_CODE_RETENTION_HOURS=  # optional, defaults to 24
# OTP_CLEANUP_MIN_INTERVAL_SECONDS=  # optional, defaults to 300 (5 minutes)
# RATE_LIMIT_OTP_MAX_REQUESTS=  # optional, defaults to 20
# RATE_LIMIT_OTP_WINDOW_SECONDS=  # optional, defaults to 3600 (1 hour)
# RATE_LIMIT_OTP_VERIFY_MAX_REQUESTS=  # optional, defaults to 30 (per IP)
# RATE_LIMIT_OTP_VERIFY_WINDOW_SECONDS=  # optional, defaults to 3600 (1 hour)
# RATE_LIMIT_CHECKOUT_MAX_REQUESTS=  # optional, defaults to 10 (per IP, Stripe checkout sessions)
# RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=  # optional, defaults to 3600 (1 hour)
# RATE_LIMIT_DEFAULT_MAX_REQUESTS=  # optional, defaults to 300
# RATE_LIMIT_DEFAULT_WINDOW_SECONDS=  # optional, defaults to 300 (5 minutes)
# EMAIL_CHANGE_MAX_REQUESTS_PER_WINDOW=  # optional, defaults to 5 (per-user cap on /auth/me/email/request)
# EMAIL_CHANGE_WINDOW_SECONDS=  # optional, defaults to 3600 (1 hour)
# ADMIN_MFA_MAX_AGE_MINUTES=  # optional, defaults to 60 — how long one TOTP check opens /admin
# ADMIN_RECENT_MFA_MAX_AGE_MINUTES=  # optional, defaults to 5 — how old a TOTP check may be for exporting/deleting an account
# ADMIN_MFA_MAX_ATTEMPTS_PER_WINDOW=  # optional, defaults to 5 (per-admin TOTP attempts)
# ADMIN_MFA_WINDOW_SECONDS=  # optional, defaults to 900 (15 minutes)
# QUESTION_REPORT_MAX_PER_WINDOW=  # optional, defaults to 20 (per-user cap on POST /questions/{id}/report)
# QUESTION_REPORT_WINDOW_SECONDS=  # optional, defaults to 3600 (1 hour)
# CATALOG_CACHE_TTL_SECONDS=  # optional, defaults to 3600 (1 hour)
# LOG_LEVEL=  # optional, defaults to INFO (DEBUG, INFO, WARNING, ERROR)
# LOG_FORMAT=  # optional, defaults to text; render.yaml sets json for Better Stack
# BETTERSTACK_HEARTBEAT_URL=  # optional, daily-report cron only; empty = no heartbeat ping
# The OTP_*, RATE_LIMIT_*, GRADING_*, … knobs above default to the production values; they exist so
# local dev/CI can loosen them. Not an env var: the disposable-email-domain blocklist is bundled data
# (disposable-email-domains in requirements.in), bumped by Dependabot.
# Planned, not yet read by the app (SSO isn't built): GOOGLE_/FACEBOOK_/X_OAUTH_CLIENT_ID and _SECRET.
