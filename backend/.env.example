DATABASE_URL=postgresql://sks_lotse:sks_lotse@localhost:5432/sks_lotse
# Required — no insecure fallback. Any value works for local dev (signs
# JWTs and hashes OTP codes); generate one with `openssl rand -hex 32`.
JWT_SECRET=
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=  # optional, defaults to 10080 (7 days)
OPENAI_API_KEY=
ADSENSE_CLIENT_ID=
# Required to actually send OTP emails locally — leave empty to see the
# "Failed to send OTP email" log line instead (the API still returns 202).
RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=  # optional, defaults to noreply@sks-lotse.de
# ALLOWED_EMAILS=  # optional, comma-separated login allowlist — leave unset locally
