        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Verify with an upper-cased email on purpose: addresses are normalized to",
                  "// lowercase server-side, so this must still match the code requested with",
                  "// the lowercase testEmail (and /me must report the lowercase form).",
                  "pm.collectionVariables.set('testEmailUpper', pm.collectionVariables.get('testEmail').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test('returns a bearer access token', function () {",
                  "    pm.expect(body.token_type).to.eql('bearer');",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.test('token response is not cacheable', function () {",
                  "    pm.response.to.have.header('Cache-Control', 'no-store');",
                  "});"
                ]
              }
            }
