    {
      "name": "Rate Limiting",
      "item": [
        {
          "name": "OTP request burst (trips the per-IP quota)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('otpBurstCount')) {",
                  "    pm.collectionVariables.set('otpBurstCount', '0');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Doesn't assume a fixed request count before the quota trips: the exact rule is",
                  "// 20 requests/hour per IP (app/main.py), but this run may not be the first hit",
                  "// against that path (the Auth Flow folder's own 'Request OTP' already used one),",
                  "// so detect the 202->429 transition instead of hardcoding where it happens.",
                  "var MAX_ATTEMPTS = 25;",
                  "var count = parseInt(pm.collectionVariables.get('otpBurstCount'), 10) + 1;",
                  "pm.collectionVariables.set('otpBurstCount', count.toString());",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.test('quota exceeded after ' + count + ' request(s): 429 Too Many Requests', function () {",
                  "        pm.response.to.have.status(429);",
                  "    });",
                  "    pm.collectionVariables.unset('otpBurstCount');",
                  "} else if (count < MAX_ATTEMPTS) {",
                  "    pm.test('request ' + count + ' within quota: 202 Accepted', function () {",
                  "        pm.response.to.have.status(202);",
                  "    });",
                  "    postman.setNextRequest('OTP request burst (trips the per-IP quota)');",
                  "} else {",
                  "    pm.collectionVariables.unset('otpBurstCount');",
                  "    pm.test('quota trips within ' + MAX_ATTEMPTS + ' requests', function () {",
                  "        throw new Error('never got a 429 - is the 20/hour otp/request rule still ' + 'configured in app/main.py?');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
